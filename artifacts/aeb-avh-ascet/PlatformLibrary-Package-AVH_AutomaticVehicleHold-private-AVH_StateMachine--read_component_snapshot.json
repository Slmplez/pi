{"type":"response","protocolVersion":1,"ok":true,"result":{"componentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_StateMachine","kind":"StateMachine","componentKind":"StateMachine","languageKind":"ESDL","counts":{"diagrams":2,"methods":2,"elements":27,"implementationElements":27,"references":5},"Component":{"Name":"AVH_StateMachine","Path":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_StateMachine","Kind":"StateMachine","LanguageKind":"ESDL"},"Diagrams":[{"Name":"Main","OwningComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_StateMachine","DiagramKind":"StateMachineDiagram"},{"Name":"Public","OwningComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_StateMachine","DiagramKind":"BlockDiagram"}],"Methods":[{"ComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_StateMachine","ComponentKind":"StateMachine","LanguageKind":"ESDL","MethodName":"TriggerTransition","MethodKind":"Trigger","Code":""},{"ComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_StateMachine","ComponentKind":"StateMachine","LanguageKind":"ESDL","MethodName":"calc","MethodKind":"AbstractMethod","Code":"/*****************************************************************************/\r\n/************************Pre-Calculations*************************************/\r\nif(CsmParkBrakeState == CSMApbSysState_Applied)\r\n{\r\n\tParkReqTriggered = false;\r\n}else{\r\n\tParkReqTriggered = ParkReqTriggered;\r\n}\r\n\r\nif(ParkReqTriggered == true)\r\n{\r\n\ttimeParkApplyTimeUp = (timeParkApplyTimeUp + CycleTime).min(C_CSM_ParkApplyReqTimeUp + 2*CycleTime);\r\n\tif(timeParkApplyTimeUp \u003e C_CSM_ParkApplyReqTimeUp)\r\n\t{\r\n\t\tParkApplyTimeUp = true;\r\n\t}\r\n}else\r\n{\r\n\ttimeParkApplyTimeUp = 0;\r\n\tParkApplyTimeUp = false;\r\n}\r\n\r\nif(AVHHoldReq == CSMHoldReq_Release)\r\n{\r\n\ttimeInRelease = (timeInRelease + CycleTime).min(C_CSM_CSMTimeTriggerRelease + 2*CycleTime);\r\n}else\r\n{\r\n\ttimeInRelease = 0;\r\n}\r\n\r\n\r\n/*****************************************************************************/\r\n/***************Determination of relevant trigger*****************************/\r\n\r\n\r\n// trigger pressure release out of hydraulic hold if ...\r\nif(AVHTrig_Release\t== true)\t\t\t\t\t\t\t// function triggers release\r\n{\r\n\tTrig_Release = true;\r\n}else\r\n{\r\n\tTrig_Release = false;\r\n}\r\n\r\n// trigger for DriveOff \r\nif(\t\t(\tCsmHoldState == CSMHoldState_DriveOff\r\n\t\t||\tCsmHoldState == CSMHoldState_DriveOffTrqBal\r\n\t\t||\tCsmHoldState == CSMHoldState_Deact) // Deact considered due to robustness\r\n\t\u0026\u0026\tTrig_Release  == false\r\n\t\u0026\u0026\tAVHReq_DriveOff == true)\r\n{\r\n\tTrig_DriveOff = true;\r\n}else\r\n{\r\n\tTrig_DriveOff = false;\r\n}\r\n\r\n// trigger Hold by AVH if ...\r\nif(\t   AVHTrig_Hold     \t\t== true\t\t\t\t\t// function triggers hold\r\n\t\u0026\u0026 Trig_Release\t\t        == false\t\t\t\t// (avoid toggeling behaviour of AVH)\r\n\t\u0026\u0026 Trig_DriveOff\t\t\t== false\r\n\t)\r\n{\r\n\tTrig_Hold = true;\r\n}\r\nelse\r\n{\r\n\tTrig_Hold = false;\r\n}\r\n\r\n// trigger Drive Off out of AVH\r\n// in case function was requesting for drive off and CSM has confirmed\r\nif(\t\t(\tCsmHoldState == CSMHoldState_DriveOff\r\n\t\t||\tCsmHoldState == CSMHoldState_DriveOffTrqBal\r\n\t\t||\tCsmHoldState == CSMHoldState_Deact) // Deact considered due to robustness\r\n\t\u0026\u0026\tTrig_Release  == false\r\n\t\u0026\u0026\tAVHReq_DriveOffK1 == true\r\n\t\u0026\u0026\tTrig_Hold == false)\r\n{\r\n\tTrig_DriveOff = true;\r\n}else\r\n{\r\n\tTrig_DriveOff = Trig_DriveOff;\r\n}\r\n\r\n\r\n\r\n\r\n/*****************************************************************************/\r\n/**********Trigger the transition first time (1 of 2)*************************/\r\nTriggerTransition();\r\n\r\n/*****************************************************************************/\r\n/************  check if park brake shall be applied  *************************/\r\n\r\n// trigger park brake to close if ... (only allowed in case parallel Hold is also triggered)\r\nif (AVHTrig_MechHold == true)\t\t\t\t// function triggers mech hold\r\n{\r\n\tif(AVHState == AVHState_Hold)\r\n\t{\r\n\t\tTrig_MechHold = true;\r\n\t}else\r\n\t{\r\n\t\tTrig_MechHold = false;\r\n\t}\r\n}else\r\n{\r\n\tTrig_MechHold = false;\r\n}\r\n\r\n\r\n\r\n// trigger Standby\r\n// in case deactivation is triggered long enough to expect that other function definitely have control\r\nTrig_NotActive = (\tAVHHoldReq == CSMHoldReq_Release\r\n\t\t\t\t\u0026\u0026\tCsmHoldState != CSMHoldState_Deact\r\n\t\t\t\t\u0026\u0026\ttimeInRelease \u003e C_CSM_CSMTimeTriggerRelease);\r\n\t\t\t\t\t\r\nTrig_NotActive = (\tTrig_NotActive\r\n\t\t\t\t||\tCsmHoldState == CSMHoldState_NotActive\r\n\t\t\t\t||\tAVHHoldReq == CSMHoldReq_None);\r\n\r\n/*****************************************************************************/\r\n/**********Trigger the transition first time (2 of 2)*************************/\r\nTriggerTransition();\r\n\r\n\r\n\r\n/*****************************************************************************/\r\n/*************Define outputs based on current state***************************/\r\nswitch(sm)\r\n{\r\n\t// Set varaibles for Not Active state\r\n\tcase NotActive:\r\n\t{\r\n\t\tAVHState = AVHState_NotActive;\r\n\t\tAVHHoldReq = CSMHoldReq_None;\r\n\t\tif(AVHTrig_Standby == true)\r\n\t\t{\r\n\t\t\tAVHHoldReq = CSMHoldReq_Standby;\r\n\t\t}\r\n\t\tAVHParkReq = CSMParkReq_None;\r\n\t\tParkReqTriggered = false;\r\n\t\tbreak;\r\n\t}\r\n\t\r\n\t// Set varaibles for Hold State\r\n\tcase Hold:\r\n\t{\r\n\t\tAVHState = AVHState_Hold;\r\n\t\tAVHHoldReq = CSMHoldReq_Hold;\r\n\t\tif(AVHReq_DriveOff == true)\r\n\t\t{\r\n\t\t\tAVHHoldReq = CSMHoldReq_DriveOff;\r\n\t\t}\r\n\r\n\t\tAVHParkReq = CSMParkReq_None;\r\n\t\tbreak;\r\n\t}\r\n\t\r\n\t// Set varaibles for Hold State\r\n\tcase MechHold:\r\n\t{\r\n\t\tAVHState = AVHState_MechHold;\r\n\t\tAVHHoldReq = CSMHoldReq_Hold;\r\n\t\tif(AVHReq_DriveOff == true)\r\n\t\t{\r\n\t\t\tAVHHoldReq = CSMHoldReq_DriveOff;\r\n\t\t}\r\n\t\t\r\n\t\tAVHParkReq = CSMParkReq_Apply;\r\n\t\tParkReqTriggered = true;\r\n\t\tbreak;\r\n\t}\r\n\t\r\n\t// Set varaibles for Drive Off\r\n\tcase DriveOff:\r\n\t{\r\n\t\tAVHState = AVHState_DriveOff;\r\n\t\tAVHHoldReq = CSMHoldReq_DriveOff;\r\n\t\t\r\n\t\tif(ParkReqTriggered == true \u0026\u0026 DriverPresence == true)\r\n\t\t{\r\n\t\t\tAVHParkReq = CSMParkReq_Release;\r\n\t\t}else\r\n\t\t{\r\n\t\t\tAVHParkReq = CSMParkReq_None;\r\n\t\t}\r\n\t\tParkReqTriggered = false;\r\n\t\tbreak;\r\n\t}\r\n\t\r\n\t// Set varaibles for Release\r\n\tcase Release:\r\n\t{\r\n\t\tAVHState = AVHState_Release;\r\n\t\tAVHHoldReq = CSMHoldReq_Release;\r\n\t\tif(\t\tTrig_Release == false\r\n\t\t\t\u0026\u0026\tAVHReq_DriveOff == true)\r\n\t\t{\r\n\t\t\tAVHHoldReq = CSMHoldReq_DriveOff;\r\n\t\t}\r\n\t\t\r\n\t\tAVHParkReq = CSMParkReq_None;\r\n\t\tbreak;\r\n\t}\r\n\r\n\t// Set varaibles in case of undefined (Must not happen! Please consider all states above)\r\n\tdefault:\r\n\t{\r\n\t\tAVHState = AVHState_NotActive;\r\n\t\tAVHHoldReq = CSMHoldReq_None;\r\n\t\t\t\t\r\n\t\tAVHParkReq = CSMParkReq_None;\r\n\t\tParkReqTriggered = false;\r\n\t\tbreak;\r\n\t}\r\n}\r\n\r\n\r\n/*****************************************************************************/\r\n/*************Post Calculations***************************/\r\n\r\n//Storage\r\nAVHReq_DriveOffK1 = AVHReq_DriveOff;"}],"TextCode":{"ComponentPath":"","ComponentKind":"","LanguageKind":"","HeaderCode":"","ExternalCCode":""},"Implementation":{"ComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_StateMachine","ComponentKind":"StateMachine","LanguageKind":"ESDL","ImplementationSourceKind":"ImplementationConfiguration","Mode":"Default","RequestedImplementationName":"","ResolvedImplementationName":"Impl","MemoryLocation":"Default","OptionGenera