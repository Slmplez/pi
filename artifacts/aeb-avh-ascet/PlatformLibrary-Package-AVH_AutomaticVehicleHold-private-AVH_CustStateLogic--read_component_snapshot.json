{"type":"response","protocolVersion":1,"ok":true,"result":{"componentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_CustStateLogic","kind":"Class","componentKind":"Class","languageKind":"ESDL","counts":{"diagrams":1,"methods":9,"elements":34,"implementationElements":34,"references":6},"Component":{"Name":"AVH_CustStateLogic","Path":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_CustStateLogic","Kind":"Class","LanguageKind":"ESDL"},"Diagrams":[{"Name":"Main","OwningComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_CustStateLogic","DiagramKind":"BlockDiagram"}],"Methods":[{"ComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_CustStateLogic","ComponentKind":"Class","LanguageKind":"ESDL","MethodName":"calc","MethodKind":"AbstractMethod","Code":"/* The purpose of this class is to specify customer specific          */\r\n/* trigger conditions of AVH state handling                           */\r\n\r\n\r\n/* Release Conditions\t\t\t\t\t\t\t\t\t\t\t\t*/\r\n\r\n/* 1: Define customer specific deactivation condition\r\n\t  CM_AVH_CustTrigRelease is used to trigger deactivation of\r\n\t  function\r\n\r\n\r\n   2: Define customer specifc deactivation strategy\r\n\t  CM_AVH_CustDeactType will be considered in Core Module and\r\n\t  to CSM.\r\n      Default-Strategy, means CSM itslef decides about the used ramp\r\n\t  \r\n   3: Define customer specific gradients\r\n\t  the gradients CM_AVH_CustjDeact and CM_AVH_CustTDeact will only\r\n\t  be considered in case related ramps (RampjCus, RampTCus) are\r\n\t  selected\t\t\t\t\t\t\t\t\t\t\t\t\t\t   */\r\n\r\n// Default values for Deactivation Type\r\nCM_AVH_CustDeactType = CSMDeactType_Default;\t\t// Default, CSM decides how to release\r\nCM_AVH_CustjDeact = 10;\t\t\t\t\t\t\t\t// Fast default values, but they are only considered in case matching ramp is triggered\r\nCM_AVH_CustTDeact = 0.1;\t\t\t\t\t\t\t// Fast default values, but they are only considered in case matching ramp is triggered\r\n// AVH Shall deactivate in case of skid  \r\nif (SkidDetected == true) \r\n{\r\n\tCM_AVH_CustTrigRelease = true;\r\n\t// in case of Skid CSM considers plain ramp by default\r\n\r\n// AVH might deactivate in case park release is triggered by button\r\n}else if(\t\tParkBrakeBttnReleaseReq == true\r\n\t\t\t\u0026\u0026\tFS_AVH_ReleaseByAPBButton == true\r\n\t\t\t\u0026\u0026\t(\tDriverBrakeApplied == true\r\n\t\t\t\t||\tDriverAccelPedalApplied == true))\r\n{\r\n\tCM_AVH_CustTrigRelease = true;\r\n\t// CSM by default considers RampTime in case there is no reason for other ramp\r\n\t\r\n// AVH deactivates in case AVH Button is pressed to disabled AVH with applied pedal\r\n}else if(\r\n\t\t   FS_AVH_HMIType    == AVHHMIType_Button\r\n\t\t\u0026\u0026 AVHButtonPressed  == true\r\n\t\t\u0026\u0026 AvhStandby        == true\r\n\t\t\u0026\u0026\t(\tDriverBrakeApplied \t\t== true\r\n\t\t\t||\tDriverAccelPedalApplied == true))\r\n{\r\n\tCM_AVH_CustTrigRelease = true;\r\n\t// CSM by default considers RampTime in case there is no reason for other ramp\r\n\t\r\n// AVH deactivates in case AVH Switch is pressed to disabled AVH with applied pedal\r\n}else if(\r\n\t\t   FS_AVH_HMIType\t== AVHHMIType_Switch\r\n\t\t\u0026\u0026 AVHSwitchOn\t\t== false\r\n\t\t\u0026\u0026 AvhState \t\t== AVHState_Hold\r\n\t\t\u0026\u0026\t(\tDriverBrakeApplied \t\t== true\r\n\t\t\t||\tDriverAccelPedalApplied == true))\r\n{\r\n\tCM_AVH_CustTrigRelease = true;\r\n\t// CSM by default considers RampTime in case there is no reason for other ramp\r\n}else if(\r\n          GearBoxValid == true\r\n\t\t  \u0026\u0026 ( AvhGear== 0))\r\n{\r\n\tCM_AVH_CustTrigRelease = true;\r\n\t// From XiaoMi Requirement that N gear trigger release holding pressure.\r\n}else if(\r\n          AVHDeactivationByBrakePedal == true)\r\n{\r\n\tCM_AVH_CustTrigRelease = true;\r\n\t// From XiaoMi Requirement that deep brake to deactivate AVH.\r\n}\r\nelse\r\n{\r\n\tCM_AVH_CustTrigRelease = false;\r\n}\r\n\r\n\r\n/* Conditions to prohibit an activation of hold\t\t\t\t\t\t*/\r\n\r\n/* 1: Define customer specific conditions to avoid an activation of\r\n\t  AVH, CM_AVH_CustCondDisableHold is used to disable hold */\r\n\t  \r\n// AVH Hold shall be disabled\r\nif(\t\tCM_AVH_CustTrigRelease == true\t\t// In case release is triggered activation is avoided\r\n\t||\tSkidRisk == true\t\t\t\t\t// in case there is a risk that skid might happen, AVH shall not activate in case it\u0027s not already active\r\n\t||\tParkBrakeBttnReleaseReq == true\t\t// Avoid activation as long as apb button is pushed in release direction\r\n\t||  (GearBoxValid == true \u0026\u0026 ((AvhGear == 0) || (AvhGear == -3))) // N/P Gear disabled Hold\r\n\t// here more conditions might be set\r\n\t)\r\n{\r\n\tCM_AVH_CustCondDisableHold = true;\r\n}else\r\n{\r\n\tCM_AVH_CustCondDisableHold = false;\r\n}\r\n\r\n\r\n/* Hold Trigger conditions\t\t\t\t\t\t\t\t\t\t\t*/\r\n\r\n/* 1: Define customer specific trigger conditions for hold\r\n\t  CM_AVH_CustTrigHold is used to trigger Hold\t\t\t\t\t*/\r\n\t  \r\n// AVH shall trigger hold if, ... (only allowed in case no disable and deactivation conditions are detected)\r\nif(        CM_AVH_CustTrigRelease == true\r\n    ||    CM_AVH_CustCondDisableHold == true)\r\n{\r\n    // so far no customer specific hold conditions\r\n    CM_AVH_CustTrigHold = false;\r\n}else if (LDMSelectedController == LDMSelectedController_AEB \u0026\u0026\r\n\t\t  AVH_Standstill == true \u0026\u0026\r\t\t  OnePedalToStop_Active == false \u0026\u0026\r\n          CsmHoldState != CSMHoldState_NotActive \u0026\u0026 \r\n          CsmHoldState != CSMHoldState_Deact \u0026\u0026 \r\n          CsmHoldState != CSMHoldState_DriveOff \u0026\u0026 \r\n          CsmHoldState != CSMHoldState_DriveOffTrqBal)\r\n{\r\n        CM_AVH_CustTrigHold = true;\r\n}else\r\n{\r\n    CM_AVH_CustTrigHold = false;\r\n}\r\n\r\n/* Take Over conditions\t\t\t\t\t\t\t\t\t\t\t\t*/\r\n\r\n/* 1: Define customer specific take over condition\r\n\t  CM_AVH_CustTrigTakeOver is used to trigger takeover to \r\n\t  park brake\t\t\t\t\t\t\t\t\t\t\t\t\t*/\r\n\t  \r\n// AVH shall take over to park brake in case AVH Button is pressed while Avh is enabled and no pedal is applied\r\n// Core logic already considers to allow secure trigger only in case Hold is also applied\r\nif(\r\n\t\t   FS_AVH_HMIType    == AVHHMIType_Button\r\n\t\t\u0026\u0026 AVHButtonPressed  == true\r\n\t\t\u0026\u0026 AvhStandby        == true\r\n\t\t\u0026\u0026 DriverBrakeApplied == false\r\n\t\t\u0026\u0026 DriverAccelPedalApplied == false)\r\n{\r\n\tCM_AVH_CustTrigTakeOver = true;\r\n\t\r\n// AVH shall take over to park brake in case AVH Switch shows disabled AVH while AVH is enabled and no pedal is applied\r\n// Core logic already considers to allow secure trigger only in case Hold is also applied\r\n}else if(\r\n\t\t   FS_AVH_HMIType    == AVHHMIType_Switch\r\n\t\t\u0026\u0026 AVHSwitchOn \t\t == false\r\n\t\t\u0026\u0026 AvhStandby        == true\r\n\t\t\u0026\u0026 DriverBrakeApplied == false\r\n\t\t\u0026\u0026 DriverAccelPedalApplied == false)\r\n{\r\n\tCM_AVH_CustTrigTakeOver = true;\r\n\t\r\n\t\r\n// P gear request APB take over by LDM even if APB don\u0027t request AutoApply itself due to VCCD failure.\r\n}else if(\r\n\t\t  GearBoxValid == true \r\n\t\t  \u0026\u0026 (AvhGear == -3))\r\n{\r\n\tCM_AVH_CustTrigTakeOver = true;\r\n\t\r\n}else\r\n{\r\n\tCM_AVH_CustTrigTakeOver = false;\r\n}\r\n\r\n/* Standby Service Conditions */\r\n// might be used for rollout conditions\r\nif(\t\tCM_AVH_CustTrigRelease == false\r\n\t\u0026\u0026\tCM_AVH_CustCondDisableHold == false)\r\n{\r\n\t// not used so far\r\n\tCM_AVH_CustTrigStandbyService = false;\r\n\r\n}else\r\n{\r\n\tCM_AVH_CustTrigStandbyService = false;\r\n}"},{"ComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_CustStateLogic","ComponentKind":"Class","LanguageKind":"ESDL","MethodName":"CM_AVH_CustCondDisableHold","Met