{"type":"response","protocolVersion":1,"ok":true,"result":{"componentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_TriggerAvhStatemachine","kind":"Class","componentKind":"Class","languageKind":"ESDL","counts":{"diagrams":1,"methods":6,"elements":39,"implementationElements":39,"references":6},"Component":{"Name":"AVH_TriggerAvhStatemachine","Path":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_TriggerAvhStatemachine","Kind":"Class","LanguageKind":"ESDL"},"Diagrams":[{"Name":"Main","OwningComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_TriggerAvhStatemachine","DiagramKind":"BlockDiagram"}],"Methods":[{"ComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_TriggerAvhStatemachine","ComponentKind":"Class","LanguageKind":"ESDL","MethodName":"calc","MethodKind":"AbstractMethod","Code":"/******************* Core Conditions for AVH Hold ***************************/\r\nHoldCoreConditions =\r\n(\t\tTargetStateAvh     \t\t== AVH_On\t\t\t\t\t// if AVH is isn\u0027t degraded\r\n\t\u0026\u0026 \tCurrentSystemMode\t\t== CSMCurSysMode_NORMAL\t\t// ignition is ON\r\n\t\u0026\u0026 \tAbsActive               == false\t\t\t\t\t// AND ABS is not active (Strongly Safety relevant)\r\n\t\u0026\u0026 \tEna_AVH                 == true\t\t\t\t\t\t// AND AVH is disabled due to SSM arbitration\r\n\t\u0026\u0026 \tAvhStandby              == true\t\t\t\t\t\t// AND AVH is in StandbyON\r\n\t\u0026\u0026 \tDriverPresence\t\t\t== true\t\t\t\t\t\t// AND Driver is present\r\n\t\u0026\u0026 \tAVHActTempNotAvail      == false\t\t\t\t\t// AND AVH is not temporarily disabled\r\n\t\u0026\u0026 \tAvhTimeUp\t\t\t\t== false\t\t\t\t\t// AND there is no time up of AVH detected\r\n\t\u0026\u0026 \tRollPrevOver \t  \t\t== false\t\t\t\t\t// OR maximum amount of roll preventions is reached\r\n\t\u0026\u0026 \tStateDrvUnit            != CSMStateDrvUnit_Off\t\t// AND drivetrain is available\r\n\t\u0026\u0026 \tCsmParkBrakeState       != CSMApbSysState_Applied\t// park brake is applied\r\n\t\u0026\u0026 \tCustCondDisableHold\t\t== false\t\t\t\t\t// AND no customer specific disable conditions are satisfied\r\n\t\u0026\u0026\tAvhValidityOk\t\t\t== true\t\t\t\t\t\t// Basic AVH Dependies are checked and OK\r\n\r\n);\r\n\r\n/*****************************************************************************/\r\n/***************Determination of relevant trigger*****************************/\r\n\r\n\r\n// trigger pressure release out of hydraulic hold if ...\r\nif(    Ena_AVH             \t\t== false\t\t\t\t\t\t\t// if AVH is disabled due to Standstill arbitration\r\n\t|| CsmParkBrakeState        == CSMApbSysState_Applied\t\t\t// park brake is applied\r\n\t|| AvhParkReqTimeUp\t\t\t== true\t\t\t\t\t\t\t\t// TimeUp is identified\r\n\t|| DriverAbsence\t\t  \t== true\t\t\t\t\t\t\t\t// as soon as it must be assumed that driver is absent, release must be triggered\r\n\t|| CustTrigRelease\t\t\t== true\t\t\t\t\t\t\t\t// customer specific release trigger\r\n\t|| CsmHoldSafetyLimState\t!= CSMSafeLimState_None\t\t\t\t// deactivate in case hold safety limiter is active or might activate\r\n\t)\r\n{\r\n\ttrig_Release = true;\r\n}else\r\n{\r\n\ttrig_Release = false;\r\n}\r\n\r\n\r\n// check if drive off request is allowed\r\nif(\t\ttrig_Release \t\t== false \t\t\t\t\t// Drive Off trigger is only allowed in case there is no release request\r\n\t\u0026\u0026\tTargetStateAvh     \t== AVH_On\t\t\t\t\t// if AVH is isn\u0027t degraded\r\n\t\u0026\u0026\tAvhValidityOk\t\t== true\t\t\t\t\t\t// Basic AVH Dependies are checked and OK\r\n\t\u0026\u0026\tCurrentSystemMode\t== CSMCurSysMode_NORMAL\t\t// ignition is ON\r\n\t\u0026\u0026\tDriveOffRequested\t== true)\r\n{\r\n\treq_DriveOff = true;\r\n}else\r\n{\r\n\treq_DriveOff = false;\r\n}\r\n\r\n\r\n// trigger Hold by AVH if ...\r\nif(\t   HoldCoreConditions           == true\t\t\t\t\t\t\t\t\t// Core Conditions for hold are fulfilled\r\n\t\u0026\u0026 CustCondDisableHold\t\t\t\t== false\t\t\t\t\t\t\t// AND no customer specific disable conditions are satisfied\r\n\t\u0026\u0026 (\t(\tDriverBrakeApplied\t\t== true\t\t\t\t\t\t\t\t// AND if driver is braking\r\n\t\t\t\u0026\u0026\tVehStandstill\t\t\t== true\t\t\t\t\t\t\t\t// AND standstill is detected (low speed Safety relevant)\r\n\t\t\t\u0026\u0026\tHoldForceSufficient     == true\t\t\t\t\t\t\t\t// AND current hold force is sufficient\r\n\t\t\t\u0026\u0026  AVHActivationByBrakePedal == true                           // AND Xiaomi special requirement of activation\r\n\t\t\t\u0026\u0026\tFS_AVH_EnableStandardActivation == true\t\t\t\t\t// only in case its enabled by function switch\r\n\t\t\t\u0026\u0026\treq_DriveOff\t\t\t== false)    \t\t\t\t\t\t// AND driver is not trying to accelerate\r\n\t\t||\t(\tCustTrigHold\t\t\t== true)                            // OR Customer specific conditions are satisfied\r\t\t||  (   ADSRequestAVH_Trigger   == true))\t\t\t\t\t\t\r\n\t\u0026\u0026 trig_Release\t\t        == false\t\t\t\t// (avoid toggeling behaviour of AVH)\r\n\t)\r\n{\r\n\ttrig_Hold = true;\r\n}\r\nelse\r\n{\r\n\ttrig_Hold = false;\r\n}\r\n\r\n\r\n\r\n// trigger park brake to close if ... (only allowed in case parallel Hold is also triggered)\r\nif(    TargetStateAvh     \t!= AVH_On\t\t\t\t// if AVH is degraded\r\n\t|| AvhValidityOk\t\t== false\t\t\t\t// Some basic dependency shows invalidity\r\n\t|| CurrentSystemMode\t!= CSMCurSysMode_NORMAL\t// ignition is OFF\r\n\t|| DriverPresence     \t== false\t\t\t\t// OR if driver is not present\r\n\t|| (AvhTimeUp\t        == true\t\t\t\t\t// OR maximum hold time has reached\r\n\t\t\u0026\u0026\tAvhState == AVHState_Hold)\r\n\t|| RollPrevOver \t  \t== true\t\t\t\t\t// OR maximum amount of roll preventions is reached\r\n\t|| StateDrvUnit\t\t\t== CSMStateDrvUnit_Off\t// OR if drivetrain is not active\r\n\t|| CustTrigTakeOver\t\t== true\t\t\t\t\t// configuration/customer specific trigger is detected\r\n\t)\r\n{\r\n\ttrig_MechHold = true;\r\n}else\r\n{\r\n\ttrig_MechHold = false;\r\n}\r\n\r\n// prepare trigger for standby functionality of CSM Hold Service (can be triggered by CM_AVH in case there are no release or mech-hold conditions detected)\r\nif(\t\ttrig_Release == false\r\n\t\u0026\u0026\ttrig_Hold == false\r\n\t\u0026\u0026\ttrig_MechHold == false\r\n\t\u0026\u0026\tHoldCoreConditions      == true\t\t\t\t\t\t// Core Conditions for hold are fulfilled\r\n\t\u0026\u0026\tCustTrigStandbyService\t== true)\r\n{\r\n\ttrig_StandbyService = true;\r\n}else\r\n{\r\n\ttrig_StandbyService = false;\r\n}"},{"ComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_TriggerAvhStatemachine","ComponentKind":"Class","LanguageKind":"ESDL","MethodName":"req_DriveOff","MethodKind":"AbstractMethod","Code":"return req_DriveOff;"},{"ComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_TriggerAvhStatemachine","ComponentKind":"Class","LanguageKind":"ESDL","MethodName":"trig_Hold","MethodKind":"AbstractMethod","Code":"return trig_Hold;"},{"ComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_TriggerAvhStatemachine","ComponentKind":"Class","LanguageKind":"ESDL","MethodName":"trig_MechHold","MethodKind":"AbstractMethod","Code":"return trig_MechHold;"},{"ComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_TriggerAvhStatemachine","ComponentKind":"Class","LanguageKind":"ESDL","MethodName":"trig_Release","MethodKind":"AbstractMethod","Code":"return trig_Release;"},{"ComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_TriggerAvhStatemachine","ComponentKind":"Class","LanguageKind":"ESDL","MethodName":"trig_StandbyService","MethodKind":"AbstractMethod","Code":"return trig_StandbyService;"}],"TextCode":{"ComponentPath":"","ComponentKind":"","LanguageKind":"","HeaderCode":"","ExternalCCode":""},"Implementation":{"ComponentPath":"PlatformLibrary\\Package\\AVH_AutomaticVehicleHold\\private\\AVH_TriggerAvh