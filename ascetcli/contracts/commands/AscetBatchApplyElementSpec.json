{
  "id": "AscetBatchApplyElementSpec",
  "family": "write",
  "summary": "Batch apply element specifications to multiple components",
  "usage": "[--json] < requests.json",
  "execution": {
    "kind": "bridge",
    "protocolVersion": 1,
    "subcommand": "batch",
    "operation": "apply_element_spec",
    "sessionPolicy": "fresh_session",
    "transportPolicy": "one_shot_only"
  },
  "supportsJson": true,
  "defaultOutputMode": "json",
  "risk": "write",
  "requiresSerialLiveAccess": true,
  "objectKinds": [
    "class",
    "module",
    "statemachine"
  ],
  "args": [
    {
      "name": "--json",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "description": "Flag --json"
    }
  ],
  "preconditions": [
    "ASCET ToolAPI session must be available.",
    "Live ASCET access must run through the serial executor.",
    "Target ASCET path must resolve to the expected object kind."
  ],
  "failureModes": [
    "toolapi_unavailable",
    "target_not_found",
    "write_failed"
  ],
  "examples": [
    {
      "description": "Basic usage",
      "command": "AscetBridge.exe batch apply_element_spec [--json] < requests.json"
    }
  ],
  "pitfalls": [
    "Live ASCET ToolAPI access is serial-only.",
    "Run readback and verify after successful writes."
  ],
  "operation": "batch_set_element_spec",
  "lane": "serial_write",
  "hostEligible": false,
  "supportsBatch": true,
  "executionProfile": {
    "hostSafety": "write",
    "hostPolicy": "force_one_shot",
    "timeoutClass": "write"
  },
  "hiddenFromModel": false
}
