    "Target ASCET path must resolve to the expected object kind."
  ],
  "failureModes": [
    "toolapi_unavailable",
    "target_not_found"
  ],
  "examples": [
    {
      "description": "Basic usage",
      "command": "AscetBridge.exe exec read_dependent_chain <component> <dependent-element> [--exporter <exporter-component>] [--provider-scope <scope-path>] [--max-candidates <n>] [--json] [--keep-temp] [--debug-dir <dir>]"
    }
  ],
