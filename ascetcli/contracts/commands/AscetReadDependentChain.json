    "kind": "bridge",
    "protocolVersion": 1,
    "subcommand": "exec",
    "operation": "read_dependent_chain",
    "sessionPolicy": "fresh_session",
    "transportPolicy": "one_shot_only"
  },
  "supportsJson": true,
  "defaultOutputMode": "json",
  "risk": "read",
  "requiresSerialLiveAccess": true,
  "objectKinds": [
    "class",
    "module"
  ],
