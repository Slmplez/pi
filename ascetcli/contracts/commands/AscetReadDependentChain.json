{
  "id": "AscetReadDependentChain",
  "family": "read",
  "summary": "Read a local dependent parameter formula, imported-parameter mappings, and exported-provider chain.",
  "usage": "<component> <dependent-element> [--exporter <exporter-component>] [--provider-scope <scope-path>] [--max-candidates <n>] [--json] [--keep-temp] [--debug-dir <dir>]",
