      "kind": "option",
      "type": "string",
      "required": false,
      "description": "Option value for --exporter"
    },
    {
      "name": "--provider-scope",
      "kind": "option",
      "type": "string",
      "required": false,
      "description": "Option value for --provider-scope"
    },
    {
      "name": "--max-candidates",
      "kind": "option",
      "type": "string",
      "required": false,
      "description": "Option value for --max-candidates"
    },
    {
      "name": "--json",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "description": "Flag --json"
    },
    {
      "name": "--keep-temp",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "description": "Flag --keep-temp"
    },
    {
      "name": "--debug-dir",
      "kind": "option",
      "type": "string",
      "required": false,
      "description": "Option value for --debug-dir"
    }
  ],
  "preconditions": [
