{
  "id": "AscetReadComponentUsedBy",
  "family": "refs",
  "summary": "Reverse refs within a bounded scope",
  "usage": "<component-path> --scope <folder-path> [--kind <class|module|statemachine>] [--limit <n>] [--json]",
  "execution": {
    "kind": "bridge",
    "protocolVersion": 1,
    "subcommand": "exec",
    "operation": "read_component_used_by",
    "sessionPolicy": "fresh_session",
    "transportPolicy": "one_shot_only"
  },
  "supportsJson": true,
  "defaultOutputMode": "json",
  "risk": "read",
  "requiresSerialLiveAccess": true,
  "objectKinds": [
    "class",
    "module",
    "statemachine"
  ],
  "args": [
    {
      "name": "component-path",
      "kind": "positional",
      "type": "string",
      "required": true,
      "description": "Positional argument: component-path"
    },
    {
      "name": "--scope",
      "kind": "flag",
      "type": "boolean",
      "required": true,
      "description": "Flag --scope"
    },
    {
      "name": "folder-path",
      "kind": "positional",
      "type": "string",
      "required": true,
      "description": "Positional argument: folder-path"
    },
    {
      "name": "--kind",
      "kind": "option",
      "type": "string",
      "required": false,
      "description": "Option value for --kind"
    },
    {
      "name": "--limit",
      "kind": "option",
      "type": "string",
      "required": false,
      "description": "Option value for --limit"
    },
    {
      "name": "--json",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "description": "Flag --json"
    }
  ],
  "preconditions": [
    "ASCET ToolAPI session must be available.",
    "Target ASCET path must resolve to the expected object kind."
  ],
  "failureModes": [
    "toolapi_unavailable",
    "target_not_found"
  ],
  "examples": [
    {
      "description": "Basic usage",
      "command": "AscetBridge.exe exec read_component_used_by <component-path> --scope <folder-path> [--kind <class|module|statemachine>] [--limit <n>] [--json]"
    }
  ],
  "pitfalls": [],
  "operation": "read_component_used_by",
  "lane": "legacy_read",
  "hostEligible": false,
  "supportsBatch": false,
  "executionProfile": {
    "hostSafety": "expensive_scan",
    "hostPolicy": "force_one_shot",
    "timeoutClass": "scan",
    "pageBudget": 200
  },
  "hiddenFromModel": false
}
