{
  "id": "AscetCreateMethod",
  "family": "write",
  "summary": "Create a new method in an existing component",
  "usage": "<component-path> <method-name> --method-kind <abstract|process|action|condition|trigger> [--diagram <name>] [--if-exists <fail|return-existing>] [--verify-readback] [--rollback-on-failure] [--json]",
  "execution": {
    "kind": "bridge",
    "protocolVersion": 1,
    "subcommand": "exec",
    "operation": "create_method",
    "sessionPolicy": "fresh_session",
    "transportPolicy": "one_shot_only"
  },
  "supportsJson": true,
  "defaultOutputMode": "json",
  "risk": "write",
  "requiresSerialLiveAccess": true,
  "objectKinds": [
    "class",
    "module",
    "statemachine"
  ],
  "args": [
    {
      "name": "component-path",
      "kind": "positional",
      "type": "string",
      "required": true,
      "description": "Positional argument: component-path"
    },
    {
      "name": "method-name",
      "kind": "positional",
      "type": "string",
      "required": true,
      "description": "Positional argument: method-name"
    },
    {
      "name": "--method-kind",
      "kind": "flag",
      "type": "boolean",
      "required": true,
      "description": "Flag --method-kind"
    },
    {
      "name": "abstract|process|action|condition|trigger",
      "kind": "positional",
      "type": "string",
      "required": true,
      "description": "Positional argument: abstract|process|action|condition|trigger"
    },
    {
      "name": "--diagram",
      "kind": "option",
      "type": "string",
      "required": false,
      "description": "Option value for --diagram"
    },
    {
      "name": "--if-exists",
      "kind": "option",
      "type": "string",
      "required": false,
      "description": "Option value for --if-exists"
    },
    {
      "name": "--verify-readback",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "description": "Flag --verify-readback"
    },
    {
      "name": "--rollback-on-failure",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "description": "Flag --rollback-on-failure"
    },
    {
      "name": "--json",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "description": "Flag --json"
    }
  ],
  "preconditions": [
    "ASCET ToolAPI session must be available.",
    "Live ASCET access must run through the serial executor.",
    "Target ASCET path must resolve to the expected object kind."
  ],
  "failureModes": [
    "toolapi_unavailable",
    "target_not_found",
    "write_failed"
  ],
  "examples": [
    {
      "description": "Basic usage",
      "command": "AscetBridge.exe exec create_method <component-path> <method-name> --method-kind <abstract|process|action|condition|trigger> [--diagram <name>] [--if-exists <fail|return-existing>] [--verify-readback] [--rollback-on-failure] [--json]"
    }
  ],
  "pitfalls": [
    "Live ASCET ToolAPI access is serial-only.",
    "Run readback and verify after successful writes."
  ],
  "operation": "create_method",
  "lane": "serial_write",
  "hostEligible": true,
  "supportsBatch": true,
  "executionProfile": {
    "hostSafety": "write",
    "hostPolicy": "prefer_host",
    "timeoutClass": "write"
  },
  "hiddenFromModel": false
}
