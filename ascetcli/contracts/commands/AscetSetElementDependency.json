                 {
                     "name":  "--dry-run",
                     "kind":  "flag",
                     "type":  "boolean",
                     "required":  false,
                     "description":  "Flag --dry-run"
                 },
                 {
                     "name":  "--backup-dir",
                     "kind":  "option",
                     "type":  "string",
                     "required":  false,
                     "description":  "Option value for --backup-dir"
                 },
                 {
                     "name":  "--verify-readback",
                     "kind":  "flag",
                     "type":  "boolean",
                     "required":  false,
                     "description":  "Flag --verify-readback"
                 },
                 {
                     "name":  "--json",
                     "kind":  "flag",
                     "type":  "boolean",
                     "required":  false,
                     "description":  "Flag --json"
                 }
             ],
    "preconditions":  [
                          "ASCET ToolAPI session must be available.",
                          "Live ASCET access must run through the serial executor.",
                          "Target ASCET path must resolve to the expected object kind."
                      ],
    "failureModes":  [
                         "toolapi_unavailable",
                         "target_not_found",
                         "write_failed"
                     ],
    "examples":  [
                     {
                         "description":  "Basic usage",
                         "command":  "AscetCli.exe exec set_element_dependency \u003ctarget-path\u003e \u003celement-name\u003e \u003cdependent|independent\u003e [--formula \u003cexpr\u003e] [--mapping \u003cformal=imported\u003e] [--clear-formula] [--target-kind auto|component|project|folder] [--match exact|all] [--dry-run] [--backup-dir \u003cdir\u003e] [--verify-readback] [--json]"
