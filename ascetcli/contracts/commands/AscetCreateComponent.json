{
    "id":  "AscetCreateComponent",
    "family":  "write",
    "summary":  "Create a new component shell",
    "usage":  "\u003ccomponent-path\u003e --kind \u003cclass|module|statemachine\u003e [--language \u003cESDL|BDE|C\u003e] [--if-exists \u003cfail|return-existing\u003e] [--verify-readback] [--rollback-on-failure] [--json]",
    "execution":  {
                      "kind":  "unified_cli",
                      "executableRelativePath":  "src/ascetcli/output/ascet-csharp/bin/AscetCli.exe",
                      "subcommand":  "exec",
                      "operation":  "create_component"
                  },
    "supportsJson":  true,
