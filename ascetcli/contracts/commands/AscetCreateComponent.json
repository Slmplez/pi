    "preconditions":  [
                          "ASCET ToolAPI session must be available.",
                          "Live ASCET access must run through the serial executor.",
                          "Target ASCET path must resolve to the expected object kind."
                      ],
    "failureModes":  [
                         "toolapi_unavailable",
                         "target_not_found",
                         "write_failed"
                     ],
    "examples":  [
                     {
                         "description":  "Basic usage",
                         "command":  "AscetCli.exe exec create_component \u003ccomponent-path\u003e --kind \u003cclass|module|statemachine\u003e [--language \u003cESDL|BDE|C\u003e] [--if-exists \u003cfail|return-existing\u003e] [--verify-readback] [--rollback-on-failure] [--json]"
                     }
                 ],
    "pitfalls":  [
                     "Live ASCET ToolAPI access is serial-only.",
