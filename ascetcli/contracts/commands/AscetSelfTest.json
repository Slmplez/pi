{
    "id":  "AscetSelfTest",
    "family":  "verify",
    "summary":  "Invoke unified selftest profiles through AscetCli.exe",
    "usage":  "\u003cquick|deep|smoke\u003e [--json]",
    "execution":  {
                      "kind":  "unified_cli",
                      "executableRelativePath":  "src/ascetcli/output/ascet-csharp/bin/AscetCli.exe",
                      "subcommand":  "selftest"
                  },
    "supportsJson":  true,
    "defaultOutputMode":  "json",
    "risk":  "diagnostic",
    "requiresSerialLiveAccess":  true,
    "objectKinds":  [
                        "generic"
                    ],
    "args":  [
                 {
                     "name":  "profile",
                     "kind":  "positional",
                     "type":  "enum",
                     "required":  true,
                     "description":  "Selftest profile to run.",
                     "enumValues":  [
                                        "quick",
                                        "deep",
                                        "smoke"
                                    ]
                 },
                 {
                     "name":  "--json",
                     "kind":  "flag",
                     "type":  "boolean",
                     "required":  false,
                     "description":  "Flag --json"
                 }
             ],
    "preconditions":  [
                          "ASCET ToolAPI session must be available."
                      ],
    "failureModes":  [
                         "toolapi_unavailable",
                         "target_not_found"
                     ],
    "examples":  [
                     {
                         "description":  "Basic usage",
                         "command":  "AscetCli.exe selftest \u003cquick|deep|smoke\u003e [--json]"
                     }
                 ],
    "pitfalls":  [

                 ],
    "operation":  "selftest",
    "lane":  "diagnostic",
    "hostEligible":  false,
    "supportsBatch":  false,
    "hiddenFromModel":  false
}
