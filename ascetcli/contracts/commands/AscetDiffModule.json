{
  "id": "AscetDiffModule",
  "family": "diff",
  "summary": "Module diff",
  "usage": "<left-module-path> <right-module-path> [--json] [--changes-only]",
  "execution": {
    "kind": "bridge",
    "protocolVersion": 1,
    "subcommand": "exec",
    "operation": "diff_module",
    "sessionPolicy": "fresh_session",
    "transportPolicy": "one_shot_only"
  },
  "supportsJson": true,
  "defaultOutputMode": "json",
  "risk": "diff",
  "requiresSerialLiveAccess": true,
  "objectKinds": [
    "module"
  ],
  "args": [
    {
      "name": "left-module-path",
      "kind": "positional",
      "type": "string",
      "required": true,
      "description": "Positional argument: left-module-path"
    },
    {
      "name": "right-module-path",
      "kind": "positional",
      "type": "string",
      "required": true,
      "description": "Positional argument: right-module-path"
    },
    {
      "name": "--json",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "description": "Flag --json"
    },
    {
      "name": "--changes-only",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "description": "Flag --changes-only"
    }
  ],
  "preconditions": [
    "ASCET ToolAPI session must be available.",
    "Target ASCET path must resolve to the expected object kind."
  ],
  "failureModes": [
    "toolapi_unavailable",
    "target_not_found"
  ],
  "examples": [
    {
      "description": "Basic usage",
      "command": "AscetBridge.exe exec diff_module <left-module-path> <right-module-path> [--json] [--changes-only]"
    }
  ],
  "pitfalls": [],
  "operation": "diff_module",
  "lane": "legacy_read",
  "hostEligible": false,
  "supportsBatch": false,
  "executionProfile": {
    "hostSafety": "fragile",
    "hostPolicy": "force_one_shot",
    "timeoutClass": "diff"
  },
  "hiddenFromModel": false
}
