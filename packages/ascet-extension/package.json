{
	"name": "@vaf-agentworks/ascet-copilot-extension",
	"version": "0.1.39",
	"description": "ASCET Copilot tool extension for Pi.",
	"type": "module",
	"main": "./src/index.ts",
	"engines": {
		"node": "^22.19.0 || >=24.5.0"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"copy-assets": "powershell -ExecutionPolicy Bypass -File scripts/copy-ascet-assets.ps1",
		"verify-assets": "node scripts/verify-packed-assets.mjs",
		"verify-isolated-install": "tsx scripts/verify-isolated-install.ts"
	},
	"pi": {
		"extensions": [
			"src/index.ts"
		],
		"skills": [
			"skills/ascet-engineering"
		]
	},
	"files": [
		"src",
		"templates",
		"ascet-cli",
		"skills/ascet-engineering",
		"README.md",
		"!ascet-cli/bin/**/*.log",
		"!ascet-cli/bin/**/*.out",
		"!ascet-cli/bin/**/*.err"
	],
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"typebox": "*"
	},
	"dependencies": {
		"exceljs": "4.4.0"
	},
	"private": false,
	"publishConfig": {
		"registry": "https://szh6-v-000cy.szh.apac.bosch.com/nexus/repository/ascet-copilot-npm/",
		"access": "restricted"
	}
}
