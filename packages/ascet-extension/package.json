{
	"name": "@zeerke/ascet-copilot-extension",
	"version": "0.1.31",
	"description": "ASCET Copilot tool extension for Pi.",
	"type": "module",
	"main": "./src/index.ts",
	"engines": {
		"node": "^22.19.0 || >=24.5.0"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"copy-assets": "powershell -ExecutionPolicy Bypass -File scripts/copy-ascet-assets.ps1"
	},
	"pi": {
		"extensions": [
			"src/index.ts"
		]
	},
	"files": [
		"src",
		"templates",
		"ascet-cli",
		"README.md",
		"!ascet-cli/internal-bin",
		"!ascet-cli/source",
		"!ascet-cli/bin/**/*.log",
		"!ascet-cli/bin/**/*.out",
		"!ascet-cli/bin/**/*.err"
	],
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"typebox": "*"
	},
	"dependencies": {
		"exceljs": "4.4.0"
	},
	"private": false,
	"publishConfig": {
		"access": "public"
	}
}
