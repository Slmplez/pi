{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ascet-test-verify-v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "profile",
    "status",
    "verdict",
    "checks",
    "failureCode",
    "evidencePaths"
  ],
  "properties": {
    "schemaVersion": { "const": "ascet-test-verify/v1" },
    "runId": { "type": "string", "minLength": 1 },
    "profile": { "enum": ["offline", "live"] },
    "status": { "enum": ["verified", "blocked"] },
    "verdict": { "enum": ["passed", "failed"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed"] },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "evidencePath": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "firstFailure": { "type": ["object", "null"] },
    "failureCode": { "type": "string" },
    "evidencePaths": { "type": "object" }
  },
  "additionalProperties": true
}
