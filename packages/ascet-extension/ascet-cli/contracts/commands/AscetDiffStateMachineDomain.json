{
  "id": "AscetDiffStateMachineDomain",
  "family": "diff",
  "summary": "Domain-level state machine diff",
  "usage": "<left-state-machine-path> <right-state-machine-path> [--json] [--changes-only]",
  "execution": {
    "kind": "bridge",
    "protocolVersion": 1,
    "subcommand": "exec",
    "operation": "diff_state_machine_domain",
    "sessionPolicy": "fresh_session",
    "transportPolicy": "one_shot_only"
  },
  "supportsJson": true,
  "defaultOutputMode": "json",
  "risk": "diff",
  "requiresSerialLiveAccess": true,
  "objectKinds": [
    "statemachine"
  ],
  "args": [
    {
      "name": "left-state-machine-path",
      "kind": "positional",
      "type": "string",
      "required": true,
      "description": "Positional argument: left-state-machine-path"
    },
    {
      "name": "right-state-machine-path",
      "kind": "positional",
      "type": "string",
      "required": true,
      "description": "Positional argument: right-state-machine-path"
    },
    {
      "name": "--json",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "description": "Flag --json"
    },
    {
      "name": "--changes-only",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "description": "Flag --changes-only"
    }
  ],
  "preconditions": [
    "ASCET ToolAPI session must be available.",
    "Target ASCET path must resolve to the expected object kind."
  ],
  "failureModes": [
    "toolapi_unavailable",
    "target_not_found"
  ],
  "examples": [
    {
      "description": "Basic usage",
      "command": "AscetBridge.exe exec diff_state_machine_domain <left-state-machine-path> <right-state-machine-path> [--json] [--changes-only]"
    }
  ],
  "pitfalls": [],
  "operation": "diff_state_machine_domain",
  "lane": "legacy_read",
  "hostEligible": false,
  "supportsBatch": false,
  "executionProfile": {
    "hostSafety": "fragile",
    "hostPolicy": "force_one_shot",
    "timeoutClass": "diff"
  },
  "hiddenFromModel": false
}
