{
  "id": "AscetGetImportBinding",
  "family": "get",
  "summary": "Read the exact imported-element binding to an explicitly identified provider.",
  "usage": "--request-json <object> [--json]",
  "execution": {
    "kind": "bridge",
    "protocolVersion": 1,
    "subcommand": "exec",
    "operation": "get_import_binding",
    "sessionPolicy": "fresh_session",
    "transportPolicy": "one_shot_only"
  },
  "supportsJson": true,
  "defaultOutputMode": "json",
  "risk": "read",
  "requiresSerialLiveAccess": true,
  "objectKinds": [
    "class",
    "module",
    "statemachine"
  ],
  "args": [
    {
      "name": "--request-json",
      "kind": "option",
      "type": "json",
      "required": true,
      "description": "Serialized request object for the get action."
    },
    {
      "name": "--json",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "description": "Emit JSON."
    }
  ],
  "preconditions": [
    "ASCET ToolAPI session must be available."
  ],
  "failureModes": [
    "toolapi_unavailable",
    "target_not_found",
    "invalid_argument"
  ],
  "examples": [
    {
      "description": "JSON request",
      "command": "AscetBridge.exe exec get_import_binding --request-json <object> --json"
    }
  ],
  "pitfalls": [
    "Traversal remains serial inside one live ToolAPI operation.",
    "Large result delivery is handled by the extension observation store, not by this command."
  ],
  "operation": "get_import_binding",
  "lane": "pooled_read",
  "hostEligible": true,
  "supportsBatch": true,
  "executionProfile": {
    "hostSafety": "stable",
    "hostPolicy": "prefer_host",
    "timeoutClass": "read"
  },
  "hiddenFromModel": false
}
