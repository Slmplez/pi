{
  "id": "AscetSetMethodCode",
  "family": "write",
  "summary": "Generic method write",
  "usage": "<component-path> <method-name> <code-file> [--verify-readback]",
  "execution": {
    "kind": "bridge",
    "protocolVersion": 1,
    "subcommand": "exec",
    "operation": "set_method_code",
    "sessionPolicy": "fresh_session",
    "transportPolicy": "one_shot_only"
  },
  "supportsJson": true,
  "defaultOutputMode": "json",
  "risk": "write",
  "requiresSerialLiveAccess": true,
  "objectKinds": [
    "class",
    "module",
    "statemachine"
  ],
  "args": [
    {
      "name": "component-path",
      "kind": "positional",
      "type": "string",
      "required": true,
      "description": "Positional argument: component-path"
    },
    {
      "name": "method-name",
      "kind": "positional",
      "type": "string",
      "required": true,
      "description": "Positional argument: method-name"
    },
    {
      "name": "code-file",
      "kind": "positional",
      "type": "string",
      "required": true,
      "description": "Positional argument: code-file"
    },
    {
      "name": "--verify-readback",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "description": "Flag --verify-readback"
    }
  ],
  "preconditions": [
    "ASCET ToolAPI session must be available.",
    "Live ASCET access must run through the serial executor.",
    "Target ASCET path must resolve to the expected object kind."
  ],
  "failureModes": [
    "toolapi_unavailable",
    "target_not_found",
    "write_failed"
  ],
  "examples": [
    {
      "description": "Basic usage",
      "command": "AscetBridge.exe exec set_method_code <component-path> <method-name> <code-file> [--verify-readback]"
    }
  ],
  "pitfalls": [
    "Live ASCET ToolAPI access is serial-only.",
    "Run readback and verify after successful writes."
  ],
  "operation": "set_method_code",
  "lane": "serial_write",
  "hostEligible": true,
  "supportsBatch": true,
  "executionProfile": {
    "hostSafety": "write",
    "hostPolicy": "prefer_host",
    "timeoutClass": "write"
  },
  "hiddenFromModel": false
}
