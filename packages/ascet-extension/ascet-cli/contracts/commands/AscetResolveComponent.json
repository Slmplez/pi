{
    "id":  "AscetResolveComponent",
    "family":  "search",
    "summary":  "Resolve a fuzzy component query",
    "usage":  "\u003cquery\u003e [--scope \u003cfolder-path\u003e] [--kind \u003cclass|module|statemachine\u003e] [--limit \u003cn\u003e] [--json]",
    "execution":  {
                      "kind":  "unified_cli",
                      "executableRelativePath":  "src/ascetcli/output/ascet-csharp/bin/AscetCli.exe",
                      "subcommand":  "exec",
                      "operation":  "resolve_component"
                  },
    "supportsJson":  true,
    "defaultOutputMode":  "json",
    "risk":  "read",
    "requiresSerialLiveAccess":  false,
    "objectKinds":  [
                        "generic"
                    ],
    "args":  [
                 {
                     "name":  "query",
                     "kind":  "positional",
                     "type":  "string",
                     "required":  true,
                     "description":  "Component query."
                 },
                 {
                     "name":  "--scope",
                     "kind":  "option",
                     "type":  "string",
                     "required":  false,
                     "description":  "Folder scope."
                 },
                 {
                     "name":  "--kind",
                     "kind":  "option",
                     "type":  "string",
                     "required":  false,
                     "description":  "Component kind filter."
                 },
                 {
                     "name":  "--match",
                     "kind":  "option",
                     "type":  "enum",
                     "required":  false,
                     "description":  "Match mode for component name/path matching.",
                     "enumValues":  [
                                        "exact",
                                        "glob",
                                        "contains"
                                    ]
                 },
                 {
                     "name":  "--limit",
                     "kind":  "option",
                     "type":  "string",
                     "required":  false,
                     "description":  "Maximum candidate count."
                 },
                 {
                     "name":  "--json",
                     "kind":  "flag",
                     "type":  "boolean",
                     "required":  false,
                     "description":  "Emit JSON."
                 }
             ],
    "preconditions":  [
                          "ASCET ToolAPI session must be available."
                      ],
    "failureModes":  [
                         "toolapi_unavailable",
                         "target_not_found"
                     ],
    "examples":  [
                     {
                         "description":  "Basic usage",
                         "command":  "AscetCli.exe exec resolve_component \u003cquery\u003e [--scope \u003cfolder-path\u003e] [--kind \u003cclass|module|statemachine\u003e] [--limit \u003cn\u003e] [--json]"
                     }
                 ],
    "pitfalls":  [

                 ],
    "operation":  "resolve_component",
    "lane":  "pooled_read",
    "hostEligible":  true,
    "supportsBatch":  false,
    "executionProfile":  {
                             "hostSafety":  "stable",
                             "hostPolicy":  "prefer_host",
                             "timeoutClass":  "read"
                         },
    "hiddenFromModel":  false
}
