{
    "id":  "AscetSearchOccurrences",
    "family":  "search",
    "summary":  "Bounded mixed component and element occurrence search",
    "usage":  "\u003cquery\u003e [--target component|element] [--component \u003cpath\u003e] [--scope \u003cfolder\u003e] [--limit \u003cn\u003e] [--cursor \u003ctoken\u003e] [--json]",
    "execution":  {
                      "kind":  "unified_cli",
                      "executableRelativePath":  "src/ascetcli/output/ascet-csharp/bin/AscetCli.exe",
                      "subcommand":  "exec",
                      "operation":  "search_occurrences"
                  },
    "supportsJson":  true,
    "defaultOutputMode":  "json",
    "risk":  "read",
    "requiresSerialLiveAccess":  false,
    "objectKinds":  [
                        "generic"
                    ],
    "args":  [
                 {
                     "name":  "query",
                     "kind":  "positional",
                     "type":  "string",
                     "required":  true,
                     "description":  "Occurrence query."
                 },
                 {
                     "name":  "--target",
                     "kind":  "option",
                     "type":  "enum",
                     "required":  false,
                     "description":  "Occurrence target leg. Omit for backward-compatible mixed component+element search. component searches component names/paths only; element searches element/method occurrences only.",
                     "enumValues":  [
                                        "component",
                                        "element"
                                    ]
                 },
                 {
                     "name":  "--scope",
                     "kind":  "option",
                     "type":  "string",
                     "required":  false,
                     "description":  "Folder scope."
                 },
                 {
                     "name":  "--match",
                     "kind":  "option",
                     "type":  "enum",
                     "required":  false,
                     "description":  "Match mode shared by the selected component/element occurrence leg.",
                     "enumValues":  [
                                        "exact",
                                        "glob",
                                        "contains"
                                    ]
                 },
                 {
                     "name":  "--limit",
                     "kind":  "option",
                     "type":  "string",
                     "required":  false,
                     "description":  "Maximum occurrences in this page."
                 },
                 {
                     "name":  "--cursor",
                     "kind":  "option",
                     "type":  "string",
                     "required":  false,
                     "description":  "Cursor for the selected scanning leg. In mixed mode it resumes the element scanning leg while component matches are re-evaluated per page."
                 },
                 {
                     "name":  "--json",
                     "kind":  "flag",
                     "type":  "boolean",
                     "required":  false,
                     "description":  "Emit JSON."
                 }
             ],
    "preconditions":  [
                          "ASCET ToolAPI session must be available."
                      ],
    "failureModes":  [
                         "toolapi_unavailable",
                         "target_not_found",
                         "invalid_argument",
                         "unsupported_target"
                     ],
    "examples":  [
                     {
                         "description":  "Basic usage",
                         "command":  "AscetCli.exe exec search_occurrences \u003cquery\u003e [--target component|element] [--component \u003cpath\u003e] [--scope \u003cfolder\u003e] [--limit \u003cn\u003e] [--cursor \u003ctoken\u003e] [--json]"
                     }
                 ],
    "pitfalls":  [
                     "Omitting --target keeps the legacy mixed component+element behavior.",
                     "Use --component for element searches inside a concrete component; --scope is only a folder scope.",
                     "In mixed mode the cursor resumes the element scanning leg; component matches are bounded per page.",
                     "Only searchComplete=true means the selected scanning leg is complete."
                 ],
    "operation":  "search_occurrences",
    "lane":  "legacy_read",
    "hostEligible":  false,
    "supportsBatch":  false,
    "executionProfile":  {
                             "hostSafety":  "expensive_scan",
                             "hostPolicy":  "force_one_shot",
                             "timeoutClass":  "scan",
                             "pageBudget":  200
                         },
    "hiddenFromModel":  false
}

