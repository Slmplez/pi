{
    "id":  "AscetSetEnumerators",
    "family":  "write",
    "summary":  "Set enumerator names for an ASCET Enumeration",
    "usage":  "\u003ccomponent-path\u003e --items \u003cname1,name2,...\u003e [--verify-readback] [--json]",
    "execution":  {
                      "kind":  "unified_cli",
                      "executableRelativePath":  "src/ascetcli/output/ascet-csharp/bin/AscetCli.exe",
                      "subcommand":  "exec",
                      "operation":  "set_enumerators"
                  },
    "supportsJson":  true,
    "defaultOutputMode":  "json",
    "risk":  "write",
    "requiresSerialLiveAccess":  true,
    "objectKinds":  [
                        "enumeration"
                    ],
    "args":  [
                 {
                     "name":  "component-path",
                     "kind":  "positional",
                     "type":  "string",
                     "required":  true,
                     "description":  "ASCET enumeration path."
                 },
                 {
                     "name":  "--items",
                     "kind":  "option",
                     "type":  "string",
                     "required":  true,
                     "description":  "Comma-separated enumerator names. ASCET assigns ordinal values by order."
                 },
                 {
                     "name":  "--verify-readback",
                     "kind":  "flag",
                     "type":  "boolean",
                     "required":  false,
                     "description":  "Verify enumerator readback."
                 },
                 {
                     "name":  "--json",
                     "kind":  "flag",
                     "type":  "boolean",
                     "required":  false,
                     "description":  "Emit JSON."
                 }
             ],
    "preconditions":  [
                          "ASCET ToolAPI session must be available.",
                          "Live ASCET access must run through the serial executor.",
                          "Target ASCET path must resolve to the expected object kind."
                      ],
    "failureModes":  [
                         "toolapi_unavailable",
                         "target_not_found",
                         "write_failed"
                     ],
    "examples":  [
                     {
                         "description":  "Basic usage",
                         "command":  "AscetCli.exe exec set_enumerators \u003ccomponent-path\u003e --items \u003cname1,name2,...\u003e [--verify-readback] [--json]"
                     }
                 ],
    "pitfalls":  [
                     "Live ASCET ToolAPI access is serial-only.",
                     "Run readback and verify after successful writes."
                 ],
    "operation":  "set_enumerators",
    "lane":  "serial_write",
    "hostEligible":  false,
    "supportsBatch":  false,
    "executionProfile":  {
                             "hostSafety":  "write",
                             "hostPolicy":  "force_one_shot",
                             "timeoutClass":  "write"
                         },
    "hiddenFromModel":  false
}

