{
    "id":  "AscetWarmSearchIndex",
    "family":  "search",
    "summary":  "Warm the ASCET quick-search element index for the current database",
    "usage":  "[--partition \u003cpartition\u003e] [--component \u003ccomponent-path\u003e] [--force] [--json] [--max-components \u003cn\u003e] [--include-text-code] [--max-text-chars \u003cn\u003e] [--timeout-ms \u003cms\u003e] [--progress-file \u003cpath\u003e]",
    "execution":  {
                      "kind":  "unified_cli",
                      "executableRelativePath":  "src/ascetcli/output/ascet-csharp/bin/AscetCli.exe",
                      "subcommand":  "exec",
                      "operation":  "warm_search_index"
                  },
    "supportsJson":  true,
    "defaultOutputMode":  "json",
    "risk":  "read",
    "requiresSerialLiveAccess":  false,
    "objectKinds":  [
                        "generic"
                    ],
    "args":  [
                 {
                     "name":  "--partition",
                     "kind":  "option",
                     "type":  "enum",
                     "required":  false,
                     "description":  "Index partition to warm.",
                     "enumValues":  [
                                        "p0",
                                        "components",
                                        "element_decls",
                                        "method_decls",
                                        "method_process_elements",
                                        "component_refs",
                                        "element_refs",
                                        "messages",
                                        "diagram_metadata",
                                        "text_code",
                                        "all"
                                    ]
                 },
                 {
                     "name":  "--component",
                     "kind":  "option",
                     "type":  "string",
                     "required":  false,
                     "description":  "Optional concrete component path for scoped partition refresh."
                 },
                 {
                     "name":  "--force",
                     "kind":  "flag",
                     "type":  "boolean",
                     "required":  false,
                     "description":  "Bypass a ready in-memory cache and refresh the requested partition."
                 },
                 {
                     "name":  "--json",
                     "kind":  "flag",
                     "type":  "boolean",
                     "required":  false,
                     "description":  "Emit JSON."
                 },
                 {
                     "name":  "--max-components",
                     "kind":  "option",
                     "type":  "integer",
                     "required":  false,
                     "description":  "Maximum searchable components to scan; 0 means unbounded."
                 },
                 {
                     "name":  "--include-text-code",
                     "kind":  "flag",
                     "type":  "boolean",
                     "required":  false,
                     "description":  "Include ESDL/C text-code entries when the selected partition is not components-only."
                 },
                 {
                     "name":  "--max-text-chars",
                     "kind":  "option",
                     "type":  "integer",
                     "required":  false,
                     "description":  "Maximum text-code characters to store; 0 means unbounded."
                 },
                 {
                     "name":  "--timeout-ms",
                     "kind":  "option",
                     "type":  "integer",
                     "required":  false,
                     "description":  "Maximum scan time budget in milliseconds; 0 means unbounded."
                 },
                 {
                     "name":  "--progress-file",
                     "kind":  "option",
                     "type":  "string",
                     "required":  false,
                     "description":  "Optional status sidecar path for UI progress."
                 }
             ],
    "preconditions":  [
                          "ASCET ToolAPI session must be available."
                      ],
    "failureModes":  [
                         "toolapi_unavailable",
                         "target_not_found"
                     ],
    "examples":  [
                     {
                         "description":  "Basic usage",
                         "command":  "AscetCli.exe exec warm_search_index [--partition \u003cpartition\u003e] [--component \u003ccomponent-path\u003e] [--force] [--json] [--max-components \u003cn\u003e] [--include-text-code] [--max-text-chars \u003cn\u003e] [--timeout-ms \u003cms\u003e] [--progress-file \u003cpath\u003e]"
                     }
                 ],
    "pitfalls":  [

                 ],
    "operation":  "warm_search_index",
    "lane":  "pooled_read",
    "hostEligible":  true,
    "supportsBatch":  false,
    "executionProfile":  {
                             "hostSafety":  "stable",
                             "hostPolicy":  "prefer_host",
                             "timeoutClass":  "scan",
                             "pageBudget":  200
                         },
    "hiddenFromModel":  false
}

