{
    "id":  "AscetListComponents",
    "family":  "explore",
    "summary":  "List database items and folders in a folder",
    "usage":  "\u003cfolder-path\u003e [--kind \u003call|folder|class|module|statemachine\u003e] [--language-kind \u003call|BDE|ESDL|C|Unknown\u003e] [--query \u003ctext\u003e] [--limit \u003cn\u003e] [--recursive] [--json]",
    "execution":  {
                      "kind":  "unified_cli",
                      "executableRelativePath":  "src/ascetcli/output/ascet-csharp/bin/AscetCli.exe",
                      "subcommand":  "exec",
                      "operation":  "list_components"
                  },
    "supportsJson":  true,
    "defaultOutputMode":  "json",
    "risk":  "read",
    "requiresSerialLiveAccess":  false,
    "objectKinds":  [
                        "generic"
                    ],
    "args":  [
                 {
                     "name":  "folder-path",
                     "kind":  "positional",
                     "type":  "string",
                     "required":  true,
                     "description":  "Folder path, or an empty path for the database root."
                 },
                 {
                     "name":  "--kind",
                     "kind":  "option",
                     "type":  "enum",
                     "required":  false,
                     "description":  "Database item kind filter.",
                     "enumValues":  [
                                        "all",
                                        "folder",
                                        "class",
                                        "module",
                                        "statemachine"
                                    ]
                 },
                 {
                     "name":  "--language-kind",
                     "kind":  "option",
                     "type":  "enum",
                     "required":  false,
                     "description":  "Component language filter. Folders have no language kind.",
                     "enumValues":  [
                                        "all",
                                        "BDE",
                                        "ESDL",
                                        "C",
                                        "Unknown"
                                    ]
                 },
                 {
                     "name":  "--query",
                     "kind":  "option",
                     "type":  "string",
                     "required":  false,
                     "description":  "Case-insensitive name or path filter."
                 },
                 {
                     "name":  "--limit",
                     "kind":  "option",
                     "type":  "integer",
                     "required":  false,
                     "description":  "Maximum number of matching entries. Zero returns all matches."
                 },
                 {
                     "name":  "--recursive",
                     "kind":  "flag",
                     "type":  "boolean",
                     "required":  false,
                     "description":  "Traverse descendant folders depth first."
                 },
                 {
                     "name":  "--json",
                     "kind":  "flag",
                     "type":  "boolean",
                     "required":  false,
                     "description":  "Emit JSON."
                 }
             ],
    "preconditions":  [
                          "ASCET ToolAPI session must be available."
                      ],
    "failureModes":  [
                         "toolapi_unavailable",
                         "target_not_found"
                     ],
    "examples":  [
                     {
                         "description":  "Basic usage",
                         "command":  "AscetCli.exe exec list_components \u003cfolder-path\u003e [--kind \u003call|folder|class|module|statemachine\u003e] [--language-kind \u003call|BDE|ESDL|C|Unknown\u003e] [--query \u003ctext\u003e] [--limit \u003cn\u003e] [--recursive] [--json]"
                     }
                 ],
    "pitfalls":  [

                 ],
    "operation":  "list_components",
    "lane":  "pooled_read",
    "hostEligible":  true,
    "supportsBatch":  true,
    "executionProfile":  {
                             "hostSafety":  "stable",
                             "hostPolicy":  "prefer_host",
                             "timeoutClass":  "read"
                         },
    "hiddenFromModel":  false
}

