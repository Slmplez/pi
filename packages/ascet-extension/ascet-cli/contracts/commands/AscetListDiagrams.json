                     "kind":  "option",
                     "type":  "enum",
                     "required":  false,
                     "description":  "Optional diagram kind filter.",
                     "enumValues":  [
                                        "all",
                                        "block",
                                        "block_diagram",
                                        "state",
                                        "state_machine",
                                        "sequence",
                                        "unknown"
                                    ]
                 },
                 {
                     "name":  "--json",
                     "kind":  "flag",
                     "type":  "boolean",
                     "required":  false,
                     "description":  "Emit JSON."
                 }
             ],
    "preconditions":  [
                          "ASCET ToolAPI session must be available.",
                          "Target project path must resolve in the live ASCET workspace."
                      ],
    "failureModes":  [
