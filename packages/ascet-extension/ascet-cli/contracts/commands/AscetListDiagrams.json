{
    "id":  "AscetListDiagrams",
    "family":  "explore",
    "summary":  "List diagrams for a component",
    "usage":  "\u003ccomponent-path\u003e [--diagram-kind \u003call|block|block_diagram|state|state_machine|sequence|unknown\u003e] [--json]",
    "execution":  {
                      "kind":  "unified_cli",
                      "executableRelativePath":  "src/ascetcli/output/ascet-csharp/bin/AscetCli.exe",
                      "subcommand":  "exec",
                      "operation":  "list_diagrams"
                  },
    "supportsJson":  true,
    "defaultOutputMode":  "json",
    "risk":  "read",
    "requiresSerialLiveAccess":  false,
    "objectKinds":  [
                        "class",
                        "module",
                        "statemachine",
                        "project",
                        "generic"
                    ],
    "args":  [
