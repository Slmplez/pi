{
  "id": "review-apply-verify",
  "title": "Review, apply, and verify live ASCET changes",
  "appliesTo": ["class", "module", "statemachine", "project"],
  "steps": [
    { "kind": "tool", "tool": "AscetDiffTool", "action": "review" },
    { "kind": "tool", "tool": "AscetWriteTool", "action": "apply" },
    { "kind": "tool", "tool": "AscetVerifyTool", "action": "readback" }
  ],
  "requiredRules": [
    "live_serial_only",
    "explicit_apply_confirmation",
    "write_then_readback",
    "verify_after_apply"
  ]
}
